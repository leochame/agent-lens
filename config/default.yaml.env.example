# AgentLens Configuration - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# OpenAI Gateway API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Gateway API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom proxy base URLs (override config/default.yaml)
# OPENAI_PROXY_URL=https://your-openai-proxy.com/v1
# ANTHROPIC_PROXY_URL=https://your-anthropic-proxy.com
