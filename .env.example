# AgentLens Configuration - Environment Variables Template

# Optional: Override config file path
# AGENTLENS_CONFIG=./config/default.yaml

# Optional: Override server listen address (default: from config/default.yaml)
# AGENTLENS_HOST=127.0.0.1
# AGENTLENS_PORT=5290

# Optional: Override request timeout in milliseconds
# API_TIMEOUT_MS=120000
